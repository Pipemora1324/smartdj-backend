POSTGRES_DB=smartdj
POSTGRES_USER=smartdj
POSTGRES_PASSWORD=CAMBIAR_ESTO
DATABASE_URL=postgresql://smartdj:CAMBIAR_ESTO@postgres:5432/smartdj
REDIS_URL=redis://redis:6379
SUPABASE_URL=CAMBIAR_ESTO
SUPABASE_JWKS_URL=CAMBIAR_ESTO
NODE_ENV=development
AI_SERVICE_URL=http://ai:8000
# gRPC con el motor de IA (host:puerto). Vacío = se usa HTTP con AI_SERVICE_URL. docker-compose ya lo define.
AI_GRPC_URL=
AI_GRPC_TLS=false
AI_GRPC_TIMEOUT_MS=10000
AI_GRPC_CONNECT_TIMEOUT_MS=3000
# Catálogo de la emisora: client_id de https://devportal.jamendo.com (uso no comercial).
JAMENDO_CLIENT_ID=CAMBIAR_ESTO
# Tope de consultas a Jamendo por mes (opcional, por defecto 30000).
JAMENDO_MONTHLY_BUDGET=30000
# Audius (opcional): bearer token de https://audius.co/api. Vacío = desactivado.
AUDIUS_API_KEY=
CORS_ORIGIN=http://localhost:8080,https://smart-dj-platform-frontend.vercel.app
