POSTGRES_DB=smartdj
POSTGRES_USER=smartdj
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://smartdj:change_this_local_password@postgres:5432/smartdj
REDIS_URL=redis://redis:6379
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_at_least_32_random_characters
NODE_ENV=development
COOKIE_SECURE=false
AI_SERVICE_URL=http://ai:8000
CORS_ORIGIN=http://localhost:8080,https://smart-dj-platform-frontend.vercel.app
PUBLIC_APP_URL=https://smart-dj-platform-frontend.vercel.app
# SMTP para el correo de recuperacion (opcional; si falta, se usa modo demo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartDJ <no-reply@smartdj.app>
